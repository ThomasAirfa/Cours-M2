<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean class="fr.uge.jee.onlineshop.DroneDelivery"/>
    <bean class="fr.uge.jee.onlineshop.StandardDelivery">
        <constructor-arg value="5"/>
    </bean>

    <bean class="fr.uge.jee.onlineshop.ReturnInsurance">
        <constructor-arg value="true"/>
    </bean>

    <bean class="fr.uge.jee.onlineshop.OnlineShop" autowire="constructor">
        <constructor-arg index="0" value="Amazon"/>
    </bean>
</beans>